# Veyra Environment Configuration Template
# Copy this file to .env or set these in your Windows system environment variables.

# --- Optional External AI Provider (OpenAI, DeepSeek, Groq, LM Studio) ---
# If OPENAI_API_KEY is not set, Veyra defaults strictly to local Ollama.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Local Ollama Settings (Defaults) ---
# OLLAMA_HOST=http://localhost:11434

# --- Style-Bert-VITS2 TTS Server (Defaults) ---
# SBV2_URL=http://127.0.0.1:5000
# SBV2_MODEL=jvnv-M1-jp

# --- Whisper STT Model ---
# Options: tiny, base, small, medium (Default: tiny)
# VEYRA_WHISPER_MODEL=tiny
